{
  "name": "unstroke",
  "version": "1.0.0",
  "description": "Convert stroked SVG into filled outlines with properly unioned paths",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./optimize": {
      "types": "./dist/optimize.d.ts",
      "import": "./dist/optimize.js",
      "require": "./dist/optimize.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docs": "pnpm --filter unstroke-docs dev",
    "docs:build": "pnpm --filter unstroke-docs build",
    "pixel-diff": "tsx scripts/pixel-diff.mts",
    "diff-image": "tsx scripts/diff-image.mts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "changeset": "changeset",
    "changeset:version": "changeset version"
  },
  "dependencies": {
    "clipper-lib": "^6.4.2"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.5.1",
    "@types/pngjs": "^6.0.5",
    "happy-dom": "^20.14.5",
    "pngjs": "^7.0.0",
    "svgo": "^4.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "svg",
    "stroke",
    "outline",
    "fill",
    "icons",
    "webfont",
    "path",
    "union"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "svgo": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "svgo": {
      "optional": true
    }
  },
  "bin": {
    "unstroke": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tabler/unstroke.git"
  },
  "homepage": "https://unstroke.vercel.app",
  "bugs": {
    "url": "https://github.com/tabler/unstroke/issues"
  },
  "author": "Paweł Kuna",
  "packageManager": "pnpm@10.33.2"
}
