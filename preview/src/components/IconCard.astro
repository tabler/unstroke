---
import type { IconEntry } from '../lib/icons';

interface Props {
  icon: IconEntry;
  query: string;
}
const { icon, query } = Astro.props;
---
<a class="card" href={`/icon/${icon.set}/${icon.name}${query}`}>
  <span class="name">{icon.name}</span>
  {icon.error ? (
    <pre class="error">{icon.error}</pre>
  ) : (
    <div class="row">
      <div class="checker" title="source (stroke)" set:html={icon.source} />
      <div class="checker" title="outline (fill)" set:html={icon.outline} />
      <div class="checker overlay" title="overlay: source in red over outline">
        <Fragment set:html={icon.outline} />
        <Fragment set:html={icon.reference} />
      </div>
      {icon.weights.map((w) => (
        <div class="checker weight" title={`outline at stroke-width ${w.width}`}>
          <Fragment set:html={w.outline} />
          <span>{w.width}</span>
        </div>
      ))}
    </div>
  )}
  <div class="muted meta">
    <span>{icon.outline.length} B</span>
    <span>{icon.optimized.length} B optimized</span>
    <span>{icon.ms.toFixed(1)} ms</span>
  </div>
</a>

<style>
  .card { display: block; color: var(--text); text-decoration: none; background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 10px; }
  .card:hover { border-color: var(--accent); }
  .name { display: block; color: var(--accent); font-weight: 600; margin-bottom: 8px; word-break: break-all; }
  .row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
  .row > div { aspect-ratio: 1; min-width: 0; overflow: hidden; }
  .row :global(svg) { width: 100%; height: 100%; }
  .overlay { position: relative; }
  .overlay :global(svg) { position: absolute; inset: 0; }
  .overlay :global(svg:last-child) { color: #dc2626; opacity: 0.7; }
  .weight { position: relative; }
  .weight span { position: absolute; right: 4px; bottom: 2px; font-size: 11px; color: var(--muted); }
  .meta { display: flex; gap: 10px; margin-top: 8px; font-size: 12px; }
  .error { color: #dc2626; white-space: pre-wrap; font-size: 12px; }
</style>
