---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · unstroke</title>
    <style is:global>
      :root {
        color-scheme: light dark;
        --bg: #f4f4f5;
        --card: #fff;
        --text: #18181b;
        --muted: #71717a;
        --border: #e4e4e7;
        --accent: #2563eb;
        --checker: #e5e5e5;
      }
      @media (prefers-color-scheme: dark) {
        :root { --bg: #18181b; --card: #27272a; --text: #f4f4f5; --muted: #a1a1aa; --border: #3f3f46; --checker: #3f3f46; }
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--text); font: 14px/1.4 system-ui, sans-serif; }
      a { color: var(--accent); text-decoration: none; }
      main { padding: 20px; }
      .checker { background: repeating-conic-gradient(var(--checker) 0 25%, transparent 0 50%) 0 0 / 16px 16px; border-radius: 6px; }
      .checker svg { display: block; width: 100%; height: 100%; }
      .muted { color: var(--muted); }
      code { font-family: ui-monospace, monospace; font-size: 12px; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
