{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "preserve"
  },
  "include": [".vitepress/**/*.ts", ".vitepress/**/*.vue", "**/*.paths.ts", "**/*.data.ts"]
}
