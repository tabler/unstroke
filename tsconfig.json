{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "types": [
      "node"
    ]
  },
  "include": [
    "lib",
    "test",
    "scripts"
  ],
  "exclude": [
    "scripts/experiment-*",
    "scripts/compare-size.mts"
  ]
}
